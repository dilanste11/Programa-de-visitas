@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager Navigation
@inject IJSRuntime JS

<div class="sidebar-modern @(collapseNavMenu ? "collapse" : "")">
    <!-- HEADER -->
    <div class="sidebar-header">
        <a class="brand-link" href="">
            <span class="brand-text">Tecnoware Visitas</span>
        </a>
        <button title="Navegación" class="collapse-btn d-md-none" @onclick="ToggleNavMenu">
            <i class="bi bi-x-lg"></i>
        </button>
    </div>
    
    <div class="separator-dashed"></div>

    <!-- MENU PRINCIPAL -->
    <nav class="nav-menu">
        <div class="nav-section-title">Principal</div>

        <div class="nav-item">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <div class="icon-box bg-gray"><i class="bi bi-house-door-fill"></i></div>
                <span>Inicio</span>
            </NavLink>
        </div>

        <div class="nav-item">
            <NavLink class="nav-link" href="inventario">
                <div class="icon-box bg-blue"><i class="bi bi-pc-display"></i></div>
                <span>Inventario</span>
            </NavLink>
        </div>

        <AuthorizeView Roles="Trabajador, Admin">
            <Authorized>
                <div class="nav-item">
                    <NavLink class="nav-link" href="ejecutar-visita">
                        <div class="icon-box bg-green"><i class="bi bi-play-fill"></i></div>
                        <span>Nueva Visita</span>
                    </NavLink>
                </div>
                <div class="nav-item">
                    <NavLink class="nav-link" href="tipos-dispositivos">
                        <div class="icon-box bg-cyan"><i class="bi bi-tags-fill"></i></div>
                        <span>Tipos de Dispositivo</span>
                    </NavLink>
                </div>
            </Authorized>
        </AuthorizeView>

        <div class="nav-item">
            <NavLink class="nav-link" href="historial-visitas">
                <div class="icon-box bg-purple"><i class="bi bi-clock-history"></i></div>
                <span>Historial</span>
            </NavLink>
        </div>

        <!-- SECCIÓN ADMIN -->
        <AuthorizeView Roles="Admin">
            <Authorized>
                <div class="separator-dashed my-3"></div>
                <div class="nav-section-title">Administración</div>

                <div class="nav-item">
                    <NavLink class="nav-link" href="gestion-usuarios">
                        <div class="icon-box bg-orange"><i class="bi bi-people-fill"></i></div>
                        <span>Usuarios</span>
                    </NavLink>
                </div>
                <div class="nav-item">
                    <NavLink class="nav-link" href="empresas">
                        <div class="icon-box bg-pink"><i class="bi bi-building-fill"></i></div>
                        <span>Empresas</span>
                    </NavLink>
                </div>
                <div class="nav-item">
                    <NavLink class="nav-link" href="plantillas">
                        <div class="icon-box bg-yellow"><i class="bi bi-file-earmark-ruled-fill"></i></div>
                        <span>Plantillas</span>
                    </NavLink>
                </div>
                <div class="nav-item">
                    <NavLink class="nav-link" href="asignar-visita">
                        <div class="icon-box bg-purple"><i class="bi bi-calendar-plus-fill"></i></div>
                        <span>Asignar Visita</span>
                    </NavLink>
                </div>
            </Authorized>
        </AuthorizeView>
    </nav>

    <!-- TARJETA INFERIOR (Cerrar Sesión) -->
    <div class="sidebar-footer">
        <AuthorizeView>
            <Authorized>
                <div class="user-card">
                    <div class="d-flex align-items-center mb-3">
                        <div class="avatar-circle me-3 bg-primary">
                            <!-- Toma la primera letra del nombre -->
                            @(context.User.Identity?.Name?.Substring(0, 1).ToUpper() ?? "U")
                        </div>
                        <div class="text-truncate">
                            <h6 class="mb-0 text-white fw-bold text-truncate" style="max-width: 140px;">
                                @(context.User.Identity?.Name ?? "Usuario")
                            </h6>
                            <small class="text-info fw-bold text-uppercase" style="font-size: 0.70rem; letter-spacing: 0.5px;">
                                @(context.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "Sin Rol")
                            </small>
                        </div>
                    </div>
                    <button class="btn btn-logout w-100" @onclick="CerrarSesion">
                        <i class="bi bi-box-arrow-left me-2"></i>Cerrar Sesión
                    </button>
                </div>
            </Authorized>
        </AuthorizeView>
    </div>
</div>

@code {
    private bool collapseNavMenu = false;

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }

    private async Task CerrarSesion()
    {
        // 1. Eliminamos el token guardado en el almacenamiento local
        await JS.InvokeVoidAsync("localStorage.removeItem", "authToken");

        // 2. Forzamos la recarga completa de la app hacia el login
        Navigation.NavigateTo("/login", true);
    }
}