@page "/empresas"
@using SistemaVisitas.Client.Services
@using SistemaVisitas.Shared.DTOs
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin")]
@inject EmpresasService EmpresasService

<PageTitle>Gestión de Empresas</PageTitle>

<div class="container-fluid mt-4 fade-in">
    <h2 class="fw-bold text-primary-dark mb-4"><i class="bi bi-building me-2"></i>Gestión de Clientes (Empresas)</h2>

    <div class="row">
        <!-- Tabla -->
        <div class="col-lg-7 mb-4">
            <div class="card shadow-sm border-0 rounded-3">
                <div class="card-body">
                    <h5 class="fw-bold text-muted mb-3">Empresas Registradas</h5>
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr><th>ID</th><th>Nombre</th><th>NIT</th><th>Acciones</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var emp in empresas)
                            {
                                <tr>
                                    <td><span class="badge bg-secondary">#@emp.Id</span></td>
                                    <td class="fw-bold">@emp.Nombre</td>
                                    <td>@emp.Nit</td>
                                    <td>
                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => Eliminar(emp.Id)"><i class="bi bi-trash3"></i></button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Formulario -->
        <div class="col-lg-5">
            <div class="card shadow-sm border-0 rounded-3">
                <div class="card-body p-4">
                    <h5 class="fw-bold text-primary-dark mb-4"><i class="bi bi-plus-circle me-2"></i>Registrar Empresa</h5>
                
                    @if (mostrarExito) { <div class="alert alert-success">Empresa registrada.</div> }
                    @if (!string.IsNullOrEmpty(mensajeError)) { <div class="alert alert-danger" style="overflow-wrap: break-word;">@mensajeError</div> }

                    <EditForm Model="nuevaEmpresa" OnValidSubmit="Guardar">
                        <DataAnnotationsValidator />
                        
                        <div class="mb-3">
                            <label class="form-label text-muted fw-bold">Nombre</label>
                            <InputText class="form-control" @bind-Value="nuevaEmpresa.Nombre" placeholder="Ej: Tecnoware Solutions" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label text-muted fw-bold">NIT / Documento</label>
                            <InputText class="form-control" @bind-Value="nuevaEmpresa.Nit" />
                        </div>
                        <div class="mb-4">
                            <label class="form-label text-muted fw-bold">Teléfono</label>
                            <InputText class="form-control" @bind-Value="nuevaEmpresa.Telefono" />
                        </div>

                        <div class="mb-4">
                            <label class="form-label text-muted fw-bold">Correo de Notificaciones</label>
                            <InputText class="form-control" @bind-Value="nuevaEmpresa.CorreoNotificaciones" placeholder="admin@empresa.com" />
                            <ValidationMessage For="@(() => nuevaEmpresa.CorreoNotificaciones)" class="text-danger small" />
                        </div>

                        <button type="submit" class="btn btn-primary w-100 fw-bold">Guardar Empresa</button>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private List<EmpresaDto> empresas = new();
    private EmpresaDto nuevaEmpresa = new();
    private bool mostrarExito = false;
    private string? mensajeError;

    protected override async Task OnInitializedAsync() => await Cargar();

    private async Task Cargar() => empresas = await EmpresasService.GetEmpresasAsync();

    private async Task Guardar()
    {
        mensajeError = null;
        mostrarExito = false;

        var response = await EmpresasService.CrearEmpresaAsync(nuevaEmpresa);

        if (response.IsSuccessStatusCode)
        {
            mostrarExito = true;
            nuevaEmpresa = new();
            await Cargar();
        }
        else
        {
            // Extraemos el JSON con el motivo exacto del rechazo
            var error = await response.Content.ReadAsStringAsync();
            mensajeError = $"El servidor rechazó los datos: {error}";
        }
    }
    
    private async Task Eliminar(int id)
    {
        if (await EmpresasService.EliminarEmpresaAsync(id)) await Cargar();
    }
}