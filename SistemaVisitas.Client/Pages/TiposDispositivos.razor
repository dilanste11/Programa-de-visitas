@page "/tipos-dispositivos"
@using SistemaVisitas.Client.Services
@using SistemaVisitas.Shared.DTOs
@using Microsoft.AspNetCore.Authorization
@using System.Text.Json
@attribute [Authorize(Roles = "Admin")]
@inject TiposDispositivosService TiposService

<PageTitle>Tipos de Dispositivos - Admin</PageTitle>

<div class="container-fluid mt-4 fade-in">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-primary-dark">
            <i class="bi bi-cpu me-2"></i>Gestión de Moldes (Tipos de Dispositivos)
        </h2>
    </div>

    <div class="row">
        <!-- Columna de la Tabla -->
        <div class="col-lg-6 mb-4">
            <div class="card shadow-sm border-0 rounded-3">
                <div class="card-header bg-white border-bottom-0 pt-4 pb-2">
                    <h5 class="fw-bold text-muted">Moldes Registrados</h5>
                </div>
                <div class="card-body">
                    @if (isLoading)
                    {
                        <div class="text-center py-5">
                            <div class="spinner-border text-primary" role="status"></div>
                        </div>
                    }
                    else if (!tipos.Any())
                    {
                        <div class="alert alert-info border-0 shadow-sm">No hay moldes configurados.</div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle custom-table">
                                <thead class="table-light">
                                    <tr>
                                        <th>ID</th>
                                        <th>Nombre</th>
                                        <th class="text-center">Acciones</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var tipo in tipos)
                                    {
                                        <tr>
                                            <td><span class="badge bg-secondary">#@tipo.Id</span></td>
                                            <td class="fw-semibold">@tipo.Nombre</td>
                                            <td class="text-center">
                                                <button class="btn btn-sm btn-outline-info me-1" @onclick="() => MostrarPreview(tipo)" title="Previsualizar">
                                                    <i class="bi bi-eye"></i>
                                                </button>
                                                <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => EditarTipo(tipo)" title="Editar">
                                                    <i class="bi bi-pencil"></i>
                                                </button>
                                                <button class="btn btn-sm btn-outline-danger" @onclick="() => EliminarTipo(tipo.Id)" title="Eliminar">
                                                    <i class="bi bi-trash3"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Columna del Formulario Constructor -->
        <div class="col-lg-6">
            <div class="card shadow-sm border-0 rounded-3 form-card">
                <div class="card-body p-4">
                    <h5 class="fw-bold text-primary-dark mb-4">
                        <i class="@((nuevoTipo.Id == 0) ? "bi bi-plus-circle" : "bi bi-pencil-square") me-2"></i>
                        @((nuevoTipo.Id == 0) ? "Crear Nuevo Molde" : $"Editando Molde #{nuevoTipo.Id}")
                    </h5>

                    @if (!string.IsNullOrEmpty(mensajeError))
                    {
                        <div class="alert alert-danger"><i class="bi bi-exclamation-triangle-fill me-2"></i>@mensajeError</div>
                    }
                    @if (mostrarExito)
                    {
                        <div class="alert alert-success"><i class="bi bi-check-circle-fill me-2"></i>Operación exitosa.</div>
                    }

                    <EditForm Model="nuevoTipo" OnValidSubmit="GuardarTipo">
                        <DataAnnotationsValidator />

                        <div class="mb-4">
                            <label class="form-label fw-bold text-muted">Nombre del Molde</label>
                            <InputText class="form-control bg-light" @bind-Value="nuevoTipo.Nombre" placeholder="Ej: Router" />
                            <ValidationMessage For="@(() => nuevoTipo.Nombre)" class="text-danger small" />
                        </div>

                        <div class="mb-4 p-3 border rounded bg-white shadow-sm">
                            <label class="form-label fw-bold text-primary-dark mb-3"><i class="bi bi-list-check me-2"></i>Atributos Dinámicos</label>
                            
                            @foreach (var campo in listaCampos)
                            {
                                <div class="row g-2 mb-2 align-items-center">
                                    <div class="col-sm-5">
                                        <input type="text" class="form-control form-control-sm" @bind="campo.NombreCampo" placeholder="Nombre (Ej: IP)" />
                                    </div>
                                    <div class="col-sm-4">
                                        <select class="form-select form-select-sm" @bind="campo.TipoDato">
                                            <option value="texto">Texto</option>
                                            <option value="numero">Número</option>
                                            <option value="fecha">Fecha</option>
                                        </select>
                                    </div>
                                    <div class="col-sm-2 text-center">
                                        <div class="form-check form-switch d-inline-block m-0">
                                            <input class="form-check-input" type="checkbox" @bind="campo.Requerido" />
                                        </div>
                                    </div>
                                    <div class="col-sm-1 text-end">
                                        <button type="button" class="btn btn-outline-danger btn-sm border-0" @onclick="() => EliminarCampo(campo)">
                                            <i class="bi bi-x-lg"></i>
                                        </button>
                                    </div>
                                </div>
                            }

                            <button type="button" class="btn btn-outline-primary btn-sm mt-3 w-100 border-dashed" @onclick="AgregarCampo">
                                <i class="bi bi-plus-circle me-2"></i> Agregar nuevo atributo
                            </button>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary flex-grow-1 py-2 fw-bold" disabled="@isSaving">
                                @if (isSaving)
                                {
                                    <span class="spinner-border spinner-border-sm me-2"></span> <span>Guardando...</span>
                                }
                                else
                                {
                                    <span>@((nuevoTipo.Id == 0) ? "Guardar Molde" : "Actualizar Molde")</span>
                                }
                            </button>
                            
                            @if (nuevoTipo.Id != 0)
                            {
                                <button type="button" class="btn btn-secondary py-2" @onclick="LimpiarFormulario">Cancelar</button>
                            }
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ========================================== -->
<!-- MODAL DE PREVISUALIZACIÓN DEL FORMULARIO -->
<!-- ========================================== -->
@if (mostrarModalPreview && tipoSeleccionadoParaPreview != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.6);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow">
                <div class="modal-header bg-primary-dark text-white" style="border-radius: 0.3rem 0.3rem 0 0;">
                    <h5 class="modal-title"><i class="bi bi-magic me-2"></i>Vista Previa: @tipoSeleccionadoParaPreview.Nombre</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CerrarPreview"></button>
                </div>
                <div class="modal-body p-4 bg-light">
                    <div class="alert alert-info small shadow-sm">
                        <i class="bi bi-info-circle-fill me-2"></i>Así verá el usuario el formulario cuando registre un equipo físico de este tipo.
                    </div>
                    
                    <div class="card border-0 shadow-sm">
                        <div class="card-body">
                            <form>
                                @foreach (var campo in camposPreview)
                                {
                                    <div class="mb-3">
                                        <label class="form-label fw-bold text-muted">
                                            @campo.NombreCampo
                                            @if(campo.Requerido) { <span class="text-danger ms-1" title="Requerido">*</span> }
                                        </label>
                                        
                                        @if (campo.TipoDato == "texto")
                                        {
                                            <input type="text" class="form-control" placeholder="Escriba aquí..." disabled />
                                        }
                                        else if (campo.TipoDato == "numero")
                                        {
                                            <input type="number" class="form-control" placeholder="0" disabled />
                                        }
                                        else if (campo.TipoDato == "fecha")
                                        {
                                            <input type="date" class="form-control" disabled />
                                        }
                                    </div>
                                }
                            </form>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CerrarPreview">Cerrar</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<TipoDispositivoDto> tipos = new();
    private TipoDispositivoDto nuevoTipo = new();
    private List<CampoEsquema> listaCampos = new() { new CampoEsquema() };
    
    private bool isLoading = true;
    private bool isSaving = false;
    private string? mensajeError;
    private bool mostrarExito = false;

    // Variables para el Modal de Preview
    private bool mostrarModalPreview = false;
    private TipoDispositivoDto? tipoSeleccionadoParaPreview;
    private List<CampoEsquema> camposPreview = new();

    public class CampoEsquema
    {
        public string NombreCampo { get; set; } = "";
        public string TipoDato { get; set; } = "texto";
        public bool Requerido { get; set; } = false;
    }

    protected override async Task OnInitializedAsync()
    {
        await CargarTipos();
    }

    private async Task CargarTipos()
    {
        isLoading = true;
        tipos = await TiposService.GetTiposAsync();
        isLoading = false;
    }

    private void AgregarCampo()
    {
        listaCampos.Add(new CampoEsquema());
    }

    private void EliminarCampo(CampoEsquema campo)
    {
        listaCampos.Remove(campo);
        if (!listaCampos.Any()) listaCampos.Add(new CampoEsquema());
    }

    // --- LÓGICA DE EDICIÓN ---
    private void EditarTipo(TipoDispositivoDto tipo)
    {
        mensajeError = null;
        mostrarExito = false;
        
        // Copiamos los datos básicos
        nuevoTipo = new TipoDispositivoDto 
        { 
            Id = tipo.Id, 
            Nombre = tipo.Nombre, 
            EsquemaMolde = tipo.EsquemaMolde 
        };

        // Deserializamos el JSON guardado de vuelta al constructor visual
        try
        {
            var opciones = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };
            listaCampos = JsonSerializer.Deserialize<List<CampoEsquema>>(tipo.EsquemaMolde, opciones) ?? new() { new CampoEsquema() };
        }
        catch
        {
            listaCampos = new() { new CampoEsquema() };
        }
    }

    private void LimpiarFormulario()
    {
        nuevoTipo = new TipoDispositivoDto();
        listaCampos = new() { new CampoEsquema() };
        mensajeError = null;
        mostrarExito = false;
    }

    // --- LÓGICA DE PREVISUALIZACIÓN ---
    private void MostrarPreview(TipoDispositivoDto tipo)
    {
        tipoSeleccionadoParaPreview = tipo;
        try
        {
            var opciones = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };
            camposPreview = JsonSerializer.Deserialize<List<CampoEsquema>>(tipo.EsquemaMolde, opciones) ?? new();
            mostrarModalPreview = true;
        }
        catch
        {
            mensajeError = "No se pudo generar la vista previa debido a un error en el formato JSON.";
        }
    }

    private void CerrarPreview()
    {
        mostrarModalPreview = false;
        tipoSeleccionadoParaPreview = null;
    }

    // --- LÓGICA DE GUARDADO (CREAR Y ACTUALIZAR) ---
    private async Task GuardarTipo()
    {
        isSaving = true;
        mensajeError = null;
        mostrarExito = false;

        var camposValidos = listaCampos.Where(c => !string.IsNullOrWhiteSpace(c.NombreCampo)).ToList();

        if (!camposValidos.Any())
        {
            mensajeError = "Debes definir al menos un atributo válido.";
            isSaving = false;
            return;
        }

        var opciones = new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase };
        nuevoTipo.EsquemaMolde = JsonSerializer.Serialize(camposValidos, opciones);

        bool exito;
        // Si el ID es 0, estamos Creando. Si tiene ID, estamos Actualizando.
        if (nuevoTipo.Id == 0)
        {
            exito = await TiposService.CrearTipoAsync(nuevoTipo);
        }
        else
        {
            exito = await TiposService.ActualizarTipoAsync(nuevoTipo);
        }

        if (exito)
        {
            mostrarExito = true;
            LimpiarFormulario();
            await CargarTipos();
        }
        else
        {
            mensajeError = "Error al comunicarse con la base de datos.";
        }
        isSaving = false;
    }

    private async Task EliminarTipo(int id)
    {
        var exito = await TiposService.EliminarTipoAsync(id);
        if (exito) await CargarTipos();
    }
}