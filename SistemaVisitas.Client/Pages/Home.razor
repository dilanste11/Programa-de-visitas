@page "/"
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Authorization
@using SistemaVisitas.Shared.DTOs
@using SistemaVisitas.Client.Services
@attribute [Authorize]
@inject DashboardService DashboardService

<PageTitle>Inicio - Tecnoware Visitas</PageTitle>

<div class="container-fluid mt-4 fade-in">
    <div class="mb-4">
        <h2 class="fw-bold text-primary-dark">
            <i class="bi bi-house-door-fill me-2"></i>Panel de Control
        </h2>
        <p class="text-muted">Bienvenido al sistema de gestión de visitas técnicas y activos.</p>
    </div>

    <!-- ========================================== -->
    <!-- 👑 VISTA DEL ADMINISTRADOR                 -->
    <!-- ========================================== -->
    <AuthorizeView Roles="Admin">
        <Authorized>
            <div class="row mb-4">
                <div class="col-md-4 mb-3">
                    <div class="card shadow-sm border-0 border-start border-primary border-4 h-100">
                        <div class="card-body">
                            <div class="text-muted small fw-bold text-uppercase"><i class="bi bi-building me-1"></i> Empresas Registradas</div>
                            <h3 class="fw-bold text-dark mt-2 mb-0">@stats.TotalEmpresas</h3>
                        </div>
                    </div>
                </div>
                <div class="col-md-4 mb-3">
                    <div class="card shadow-sm border-0 border-start border-success border-4 h-100">
                        <div class="card-body">
                            <div class="text-muted small fw-bold text-uppercase"><i class="bi bi-check-circle me-1"></i> Visitas (Mes)</div>
                            <h3 class="fw-bold text-dark mt-2 mb-0">@stats.VisitasMesAdmin</h3>
                        </div>
                    </div>
                </div>
                <div class="col-md-4 mb-3">
                    <div class="card shadow-sm border-0 border-start border-warning border-4 h-100">
                        <div class="card-body">
                            <div class="text-muted small fw-bold text-uppercase"><i class="bi bi-tools me-1"></i> Equipos en Reparación</div>
                            <h3 class="fw-bold text-dark mt-2 mb-0">@stats.EquiposEnReparacionAdmin</h3>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="card shadow-sm border-0">
                <div class="card-body bg-light rounded text-center p-4">
                    <h5 class="fw-bold"><i class="bi bi-gear-fill text-secondary me-2"></i>Accesos Rápidos</h5>
                    <div class="mt-3">
                        <a href="gestion-usuarios" class="btn btn-outline-primary mx-2"><i class="bi bi-people-fill me-2"></i>Gestión Usuarios</a>
                        <a href="empresas" class="btn btn-outline-primary mx-2"><i class="bi bi-building-fill me-2"></i>Gestión Empresas</a>
                        <a href="historial-visitas" class="btn btn-primary mx-2"><i class="bi bi-card-list me-2"></i>Ver Todas las Visitas</a>
                    </div>
                </div>
            </div>
        </Authorized>
    </AuthorizeView>

    <!-- ========================================== -->
    <!-- 🛠️ VISTA DEL TRABAJADOR / TÉCNICO          -->
    <!-- ========================================== -->
    <AuthorizeView Roles="Trabajador">
        <Authorized>
            <!-- Saludo y Botón Manual -->
            <div class="card bg-primary text-white shadow-sm border-0 rounded-3 mb-4">
                <div class="card-body p-4 d-flex flex-column flex-md-row justify-content-between align-items-center">
                    <div class="mb-3 mb-md-0 text-center text-md-start">
                        <h4 class="fw-bold mb-1">¡Hola, @context.User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value!</h4>
                        <p class="mb-0 text-white-50">Tu panel de operaciones está listo.</p>
                    </div>
                    <a href="ejecutar-visita" class="btn btn-light text-primary fw-bold btn-lg shadow-sm">
                        <i class="bi bi-play-circle-fill me-2"></i> Iniciar Visita Manual
                    </a>
                </div>
            </div>

            <!-- TABLA DE VISITAS PROGRAMADAS -->
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-white border-bottom p-3 d-flex justify-content-between align-items-center">
                    <h6 class="fw-bold mb-0 text-dark"><i class="bi bi-calendar-event me-2 text-primary"></i>Mi Agenda de Visitas</h6>
                    <span class="badge bg-primary rounded-pill">@stats.VisitasProgramadas.Count pendientes</span>
                </div>
                <div class="card-body p-0">
                    @if (!stats.VisitasProgramadas.Any())
                    {
                        <div class="text-center p-5 text-muted">
                            <i class="bi bi-calendar2-check display-4 mb-3 d-block text-secondary opacity-50"></i>
                            <h5>No tienes visitas programadas</h5>
                            <p class="small">Las visitas que te asigne el administrador aparecerán aquí.</p>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th class="ps-4">Fecha y Hora</th>
                                        <th>Cliente</th>
                                        <th>Instrucciones</th>
                                        <th class="text-end pe-4">Acción</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var visita in stats.VisitasProgramadas)
                                    {
                                        <tr>
                                            <td class="ps-4 text-nowrap">
                                                <span class="fw-bold text-dark d-block">@visita.FechaProgramada.ToString("dd MMM yyyy")</span>
                                                <span class="text-muted small">@visita.FechaProgramada.ToString("hh:mm tt")</span>
                                            </td>
                                            <td>
                                                <div class="d-flex align-items-center">
                                                    <div class="avatar-circle bg-light text-primary me-2 shadow-sm" style="width: 35px; height: 35px;">
                                                        <i class="bi bi-building"></i>
                                                    </div>
                                                    <span class="fw-semibold">@visita.EmpresaNombre</span>
                                                </div>
                                            </td>
                                            <td class="text-muted small">
                                                @(string.IsNullOrEmpty(visita.NotasAdmin) ? "Sin instrucciones previas." : visita.NotasAdmin)
                                            </td>
                                            <td class="text-end pe-4">
                                                <a href="ejecutar-visita/@visita.Id" class="btn btn-sm btn-success fw-bold shadow-sm rounded-pill px-3">
                                                    <i class="bi bi-play-fill me-1"></i> Iniciar
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
            <div class="row mb-4">
                <div class="col-md-6 mb-3">
                    <div class="card shadow-sm border-0 h-100">
                        <div class="card-body text-center p-4">
                            <i class="bi bi-clipboard-check text-success" style="font-size: 3rem;"></i>
                            <h3 class="fw-bold mt-3">@stats.VisitasMesTrabajador</h3>
                            <p class="text-muted">Visitas finalizadas este mes</p>
                            <a href="historial-visitas" class="btn btn-outline-secondary btn-sm">Ver mi historial</a>
                        </div>
                    </div>
                </div>
                <div class="col-md-6 mb-3">
                    <div class="card shadow-sm border-0 h-100">
                        <div class="card-body text-center p-4">
                            <i class="bi bi-pc-display text-info" style="font-size: 3rem;"></i>
                            <h3 class="fw-bold mt-3">@stats.TotalEquiposRevisados</h3>
                            <p class="text-muted">Equipos únicos revisados</p>
                            <a href="inventario" class="btn btn-outline-secondary btn-sm">Ir al Inventario</a>
                        </div>
                    </div>
                </div>
            </div>
        </Authorized>
    </AuthorizeView>

    <!-- ========================================== -->
    <!-- 🏢 VISTA DE LA EMPRESA / CLIENTE           -->
    <!-- ========================================== -->
    <AuthorizeView Roles="Empresa">
        <Authorized>
            <div class="row mb-4">
                <div class="col-md-12 mb-4">
                    <div class="card bg-dark text-white shadow-sm border-0 rounded-3">
                        <div class="card-body p-4 d-flex justify-content-between align-items-center">
                            <div>
                                <h4 class="fw-bold mb-1">Portal de Empresa</h4>
                                <p class="mb-0 text-white-50">Consulta el estado de tus equipos y actas de servicio.</p>
                            </div>
                            <i class="bi bi-building fs-1 text-secondary opacity-50"></i>
                        </div>
                    </div>
                </div>

                <div class="col-md-6 mb-3">
                    <div class="card shadow-sm border-0 bg-light h-100 hover-card">
                        <div class="card-body text-center p-4">
                            <i class="bi bi-pc-display fs-1 text-primary mb-2"></i>
                            <h3 class="fw-bold mt-2 text-primary">@stats.TotalMisEquipos</h3>
                            <h5 class="fw-bold">Equipos en Inventario</h5>
                            <p class="text-muted small">Equipos en reparación: <strong class="text-warning">@stats.MisEquiposEnReparacion</strong></p>
                            <a href="inventario" class="btn btn-outline-primary mt-2 w-75 fw-bold">Ir al Inventario</a>
                        </div>
                    </div>
                </div>
                
                <div class="col-md-6 mb-3">
                    <div class="card shadow-sm border-0 bg-light h-100 hover-card">
                        <div class="card-body text-center p-4">
                            <i class="bi bi-file-earmark-pdf fs-1 text-danger mb-2"></i>
                            <h5 class="fw-bold mt-3">Actas de Servicio</h5>
                            <p class="text-muted small">Última visita: <strong>@(stats.FechaUltimaVisita?.ToString("dd MMM yyyy") ?? "Sin visitas previas")</strong></p>
                            <a href="historial-visitas" class="btn btn-outline-danger mt-3 w-75 fw-bold">Ver Historial</a>
                        </div>
                    </div>
                </div>
            </div>
        </Authorized>
    </AuthorizeView>
</div>

@code {
    private DashboardDto stats = new DashboardDto();
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            isLoading = true;
            // Al hacer esta llamada, el backend detecta el JWT y devuelve solo lo que necesita este rol
            stats = await DashboardService.GetEstadisticasAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar el dashboard: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }
}