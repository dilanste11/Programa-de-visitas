@page "/plantillas"
@using SistemaVisitas.Client.Services
@using SistemaVisitas.Shared.DTOs
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin")]
@inject PlantillasVisitaService PlantillasService

<PageTitle>Constructor de Plantillas</PageTitle>

<div class="container-fluid mt-4 fade-in">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-primary-dark">
            <i class="bi bi-file-earmark-ruled me-2"></i>Gestión de Plantillas de Visita
        </h2>
        @if (!modoConstructor)
        {
            <button class="btn btn-primary fw-bold shadow-sm" @onclick="NuevoConstructor">
                <i class="bi bi-plus-lg me-2"></i>Crear Nueva Plantilla
            </button>
        }
    </div>

    @if (!string.IsNullOrEmpty(mensajeError))
    {
        <div class="alert alert-danger shadow-sm"><i class="bi bi-exclamation-triangle-fill me-2"></i>@mensajeError</div>
    }
    @if (mostrarExito)
    {
        <div class="alert alert-success shadow-sm"><i class="bi bi-check-circle-fill me-2"></i>Operación guardada exitosamente.</div>
    }

    @if (!modoConstructor)
    {
        <!-- ======================= MODO LISTA ======================= -->
        <div class="card shadow-sm border-0 rounded-3">
            <div class="card-body">
                @if (isLoading)
                {
                    <div class="text-center py-4"><div class="spinner-border text-primary"></div></div>
                }
                else if (!plantillas.Any())
                {
                    <div class="alert alert-info border-0">No hay plantillas creadas. ¡Anímate a crear la primera!</div>
                }
                else
                {
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Código</th>
                                <th>Nombre de la Plantilla</th>
                                <th>Estado</th>
                                <th class="text-center">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in plantillas)
                            {
                                <tr>
                                    <td><span class="badge bg-secondary">@(p.Codigo ?? "N/A")</span></td>
                                    <td class="fw-bold text-primary-dark">@p.Nombre</td>
                                    <td>
                                        @if (p.Activa) { <span class="badge bg-success">Activa</span> } 
                                        else { <span class="badge bg-danger">Inactiva</span> }
                                    </td>
                                    <td class="text-center">
                                        <button class="btn btn-sm btn-outline-primary" @onclick="() => CargarConstructor(p.Id)">
                                            <i class="bi bi-pencil-square me-1"></i> Editar Estructura
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    }
    else
    {
        <!-- ======================= MODO CONSTRUCTOR ======================= -->
        <div class="card shadow border-0 rounded-3 mb-5 border-top border-primary border-4">
            <div class="card-header bg-white p-4 d-flex justify-content-between align-items-center">
                <h5 class="mb-0 fw-bold text-primary-dark">
                    <i class="bi bi-tools me-2"></i> @((plantillaActual.Id == 0) ? "Diseñando Nueva Plantilla" : $"Editando: {plantillaActual.Nombre}")
                </h5>
                <div>
                    <button class="btn btn-outline-secondary me-2" @onclick="CerrarConstructor">Cancelar</button>
                    <button class="btn btn-success fw-bold shadow-sm" @onclick="GuardarPlantilla" disabled="@isSaving">
                        @if(isSaving) { <span class="spinner-border spinner-border-sm me-2"></span> }
                        <i class="bi bi-save me-2"></i> Guardar Plantilla Completa
                    </button>
                </div>
            </div>
            
            <div class="card-body p-4 bg-light">
                <!-- CABECERA DE LA PLANTILLA -->
                <div class="row g-3 mb-4 p-3 bg-white rounded shadow-sm border">
                    <h6 class="fw-bold text-muted text-uppercase mb-3 border-bottom pb-2">1. Datos Generales</h6>
                    <div class="col-md-2">
                        <label class="form-label fw-bold small">Código</label>
                        <input type="text" class="form-control form-control-sm" @bind="plantillaActual.Codigo" placeholder="Ej: MT-01" />
                    </div>
                    <div class="col-md-5">
                        <label class="form-label fw-bold small">Nombre de la Plantilla *</label>
                        <input type="text" class="form-control form-control-sm" @bind="plantillaActual.Nombre" placeholder="Ej: Mantenimiento Preventivo" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-bold small">Descripción</label>
                        <input type="text" class="form-control form-control-sm" @bind="plantillaActual.Descripcion" />
                    </div>
                    <div class="col-md-2 pt-4">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" @bind="plantillaActual.Activa" id="checkActiva" />
                            <label class="form-check-label small fw-bold" for="checkActiva">Activa</label>
                        </div>
                    </div>
                </div>

                <!-- SECCIONES DE LA PLANTILLA -->
                <h6 class="fw-bold text-muted text-uppercase mb-3 mt-5">2. Estructura de Secciones e Ítems</h6>
                
                @foreach (var seccion in plantillaActual.Detalles)
                {
                    var indexSeccion = plantillaActual.Detalles.IndexOf(seccion);
                    
                    <div class="card mb-4 border-info shadow-sm">
                        <div class="card-header bg-info bg-opacity-10 d-flex justify-content-between align-items-center py-2">
                            <div class="d-flex align-items-center w-50">
                                <span class="badge bg-info text-dark me-3 fs-6">Sección @(indexSeccion + 1)</span>
                                <input type="text" class="form-control fw-bold border-info" @bind="seccion.TituloSeccion" placeholder="Nombre de la sección (Ej: Inspección Física)" />
                            </div>
                            <div>
                                <button class="btn btn-sm btn-outline-secondary me-1" @onclick="() => MoverSeccion(seccion, -1)" disabled="@(indexSeccion == 0)" title="Subir"><i class="bi bi-arrow-up"></i></button>
                                <button class="btn btn-sm btn-outline-secondary me-3" @onclick="() => MoverSeccion(seccion, 1)" disabled="@(indexSeccion == plantillaActual.Detalles.Count - 1)" title="Bajar"><i class="bi bi-arrow-down"></i></button>
                                <button class="btn btn-sm btn-danger" @onclick="() => EliminarSeccion(seccion)"><i class="bi bi-trash"></i> Eliminar Sección</button>
                            </div>
                        </div>
                        
                        <div class="card-body bg-white p-3">
                            <table class="table table-sm table-borderless align-middle mb-0">
                                <thead>
                                    <tr class="text-muted small border-bottom">
                                        <th style="width: 5%">Orden</th>
                                        <th style="width: 50%">Pregunta / Requerimiento *</th>
                                        <th style="width: 20%">Tipo de Respuesta</th>
                                        <th style="width: 10%" class="text-center">Obligatorio</th>
                                        <th style="width: 15%" class="text-end">Acciones</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in seccion.Items)
                                    {
                                        var indexItem = seccion.Items.IndexOf(item);
                                        <tr>
                                            <td>
                                                <div class="d-flex flex-column gap-1">
                                                    <button class="btn btn-xs btn-light py-0 border" @onclick="() => MoverItem(seccion, item, -1)" disabled="@(indexItem == 0)"><i class="bi bi-caret-up-fill small"></i></button>
                                                    <button class="btn btn-xs btn-light py-0 border" @onclick="() => MoverItem(seccion, item, 1)" disabled="@(indexItem == seccion.Items.Count - 1)"><i class="bi bi-caret-down-fill small"></i></button>
                                                </div>
                                            </td>
                                            <td><input type="text" class="form-control form-control-sm" @bind="item.NombreItem" placeholder="Ej: ¿El equipo enciende correctamente?" /></td>
                                            <td>
                                                <select class="form-select form-select-sm" @bind="item.TipoCampo">
                                                    <option value="Booleano">Sí / No (Booleano)</option>
                                                    <option value="Texto">Texto libre</option>
                                                    <option value="Numero">Valor Numérico</option>
                                                    <option value="Imagen">Imagen / Evidencia Fotográfica</option>
                                                </select>
                                            </td>
                                            <td class="text-center">
                                                <div class="form-check form-switch d-inline-block">
                                                    <input class="form-check-input" type="checkbox" @bind="item.EsObligatorio" />
                                                </div>
                                            </td>
                                            <td class="text-end">
                                                <button class="btn btn-sm btn-outline-danger" @onclick="() => EliminarItem(seccion, item)"><i class="bi bi-x"></i></button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                            <button class="btn btn-sm btn-outline-primary mt-3 dashed-border w-100" @onclick="() => AgregarItem(seccion)">
                                <i class="bi bi-plus-circle me-2"></i> Agregar nueva pregunta a esta sección
                            </button>
                        </div>
                    </div>
                }

                <div class="text-center mt-4">
                    <button class="btn btn-lg btn-outline-primary dashed-border" @onclick="AgregarSeccion">
                        <i class="bi bi-plus-square-dotted me-2"></i> Agregar Nueva Sección
                    </button>
                </div>
            </div>
        </div>
    }
</div>

<style>
    .dashed-border { border: 2px dashed #0d6efd; background-color: #f8f9fa; }
    .dashed-border:hover { background-color: #e9ecef; }
    .btn-xs { padding: 0.1rem 0.3rem; font-size: 0.75rem; line-height: 1; border-radius: 0.2rem; }
</style>

@code {
    private List<PlantillaVisitaDto> plantillas = new();
    private PlantillaVisitaDto plantillaActual = new();
    
    private bool isLoading = true;
    private bool isSaving = false;
    private bool modoConstructor = false;
    private string? mensajeError;
    private bool mostrarExito = false;

    protected override async Task OnInitializedAsync()
    {
        await CargarLista();
    }

    private async Task CargarLista()
    {
        isLoading = true;
        plantillas = await PlantillasService.GetPlantillasAsync();
        isLoading = false;
    }

    private void NuevoConstructor()
    {
        mensajeError = null;
        mostrarExito = false;
        plantillaActual = new PlantillaVisitaDto();
        // Agregamos una sección por defecto para que no empiece en blanco
        AgregarSeccion();
        modoConstructor = true;
    }

    private async Task CargarConstructor(int id)
    {
        mensajeError = null;
        mostrarExito = false;
        isLoading = true;
        var result = await PlantillasService.GetPlantillaCompletaAsync(id);
        if (result != null)
        {
            plantillaActual = result;
            modoConstructor = true;
        }
        else
        {
            mensajeError = "No se pudo cargar la plantilla.";
        }
        isLoading = false;
    }

    private void CerrarConstructor()
    {
        modoConstructor = false;
    }

    // --- LÓGICA DEL CONSTRUCTOR VISUAL (SECCIONES E ÍTEMS) ---
    private void AgregarSeccion()
    {
        plantillaActual.Detalles.Add(new PlantillaDetalleDto { TituloSeccion = "" });
    }

    private void EliminarSeccion(PlantillaDetalleDto seccion)
    {
        plantillaActual.Detalles.Remove(seccion);
    }

    private void AgregarItem(PlantillaDetalleDto seccion)
    {
        seccion.Items.Add(new PlantillaDetalleItemDto { NombreItem = "" });
    }

    private void EliminarItem(PlantillaDetalleDto seccion, PlantillaDetalleItemDto item)
    {
        seccion.Items.Remove(item);
    }

    // Lógica para Ordenar (Subir y Bajar)
    private void MoverSeccion(PlantillaDetalleDto seccion, int direccion)
    {
        var index = plantillaActual.Detalles.IndexOf(seccion);
        var nuevoIndex = index + direccion;
        if (nuevoIndex >= 0 && nuevoIndex < plantillaActual.Detalles.Count)
        {
            plantillaActual.Detalles.RemoveAt(index);
            plantillaActual.Detalles.Insert(nuevoIndex, seccion);
        }
    }

    private void MoverItem(PlantillaDetalleDto seccion, PlantillaDetalleItemDto item, int direccion)
    {
        var index = seccion.Items.IndexOf(item);
        var nuevoIndex = index + direccion;
        if (nuevoIndex >= 0 && nuevoIndex < seccion.Items.Count)
        {
            seccion.Items.RemoveAt(index);
            seccion.Items.Insert(nuevoIndex, item);
        }
    }

    // --- GUARDADO CONSISTENTE ---
    private async Task GuardarPlantilla()
    {
        isSaving = true;
        mensajeError = null;
        mostrarExito = false;

        // 1. Validaciones básicas en el frontend
        if (string.IsNullOrWhiteSpace(plantillaActual.Nombre))
        {
            mensajeError = "El nombre de la plantilla es obligatorio.";
            isSaving = false;
            return;
        }

        if (!plantillaActual.Detalles.Any())
        {
            mensajeError = "Debes agregar al menos una sección.";
            isSaving = false;
            return;
        }

        // 2. Auto-asignamos el Orden de las secciones e ítems según cómo los acomodó el usuario en pantalla
        for (int i = 0; i < plantillaActual.Detalles.Count; i++)
        {
            var seccion = plantillaActual.Detalles[i];
            if (string.IsNullOrWhiteSpace(seccion.TituloSeccion)) seccion.TituloSeccion = $"Sección {i + 1}";
            seccion.Orden = i + 1;

            for (int j = 0; j < seccion.Items.Count; j++)
            {
                var item = seccion.Items[j];
                if (string.IsNullOrWhiteSpace(item.NombreItem)) item.NombreItem = $"Pregunta {j + 1}";
                item.Orden = j + 1;
            }
        }

        // 3. Enviamos todo el bloque JSON masivo al backend
        HttpResponseMessage response;
        if (plantillaActual.Id == 0)
        {
            response = await PlantillasService.CrearPlantillaAsync(plantillaActual);
        }
        else
        {
            response = await PlantillasService.ActualizarPlantillaAsync(plantillaActual);
        }

        if (response.IsSuccessStatusCode)
        {
            mostrarExito = true;
            modoConstructor = false; // Cerramos el constructor y volvems a la tabla
            await CargarLista();
        }
        else
        {
            var errorText = await response.Content.ReadAsStringAsync();
            mensajeError = $"Error del servidor: {errorText}";
        }
        
        isSaving = false;
    }
}